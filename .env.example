# Kopioi tämä tiedosto nimelle .env ja täytä arvot.

# Hallintapaneelin salasana (pakollinen tuotannossa).
ADMIN_PASSWORD=vaihda-tama-pitkaan-salasanaan

# Pitkä satunnainen merkkijono kirjautumisevästeiden allekirjoitukseen.
# Jos tyhjä, kirjautuminen nollautuu aina kun palvelin käynnistyy uudelleen.
# Luo esim. komennolla: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Julkinen osoite, johon QR-koodit osoittavat (ilman loppuviivaa).
PUBLIC_URL=https://palaute.kipinabasket.fi

# Portti ja tietokantatiedosto (oletukset 3000 ja ./data/palaute.db).
PORT=3000
# DB_FILE=./data/palaute.db

# Mihin välityspalvelimiin luotetaan (Expressin "trust proxy").
# Oletus luottaa vain yksityisverkon välityspalvelimiin, mikä sopii useimpiin pilvipalveluihin.
# TRUST_PROXY=1
