{
  "name": "kipina-palaute",
  "version": "1.0.0",
  "description": "QR-koodilla toimiva palautekysely ja dashboard Kipinän Basketin ottelutapahtumille",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --env-file-if-exists=.env server.js",
